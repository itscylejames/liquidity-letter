{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liquidity-letter",
  "compatibility_date": "2026-05-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["25 7 * * *"]
  }
}
